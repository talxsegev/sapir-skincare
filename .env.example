# Copy this file to .env and fill in your EmailJS credentials.
# Get these from https://dashboard.emailjs.com/admin
# Required to build the site — the contact form will not work without them.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# The /consultation survey submits via Netlify Forms instead (it includes
# photo uploads, which are far too large for EmailJS's 50KB request cap) —
# no separate env var needed for it. See README for setup details.
