# Copy this file to .env and fill in your EmailJS credentials.
# Get these from https://dashboard.emailjs.com/admin
# Required to build the site — the contact form will not work without them.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# A separate EmailJS template for the /consultation survey (much larger than
# the contact form's template — see README for the full field list it needs).
VITE_EMAILJS_CONSULTATION_TEMPLATE_ID=
